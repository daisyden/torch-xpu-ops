import torch
import pytest

@pytest.mark.parametrize("dtype", [torch.complex64, torch.complex128])
def test_addmv_xpu(dtype):
    value = 11
    input = torch.full((2,), value, dtype=dtype, device="xpu")
    mat = torch.ones((2, 0), dtype=dtype, device="xpu")
    vec = torch.ones((0,), dtype=dtype, device="xpu")

    alpha = 6 + 7j
    beta = 3 + 4j

    torch.addmv(input=input, mat=mat, vec=vec, alpha=alpha, beta=beta)
